{
  "name": "blotato-comment-system",
  "version": "1.0.0",
  "description": "Multi-platform comment system take-home for a social media scheduling API",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node init && tsx watch src/index.ts",
    "dev:api": "tsx watch src/index.ts",
    "dev:web": "npm --prefix frontend run dev",
    "build": "node init && tsc",
    "start": "node init && node dist/index.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "setup": "prisma migrate deploy && tsx prisma/seed.ts",
    "test": "tsx --test src/**/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/client": "^6.14.0",
    "fastify": "^5.4.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "prisma": "^6.14.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
